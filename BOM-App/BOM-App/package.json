{
  "name": "bom-organizador",
  "version": "1.0.0",
  "description": "BOM! — Organizador de PDFs (app Android com Capacitor)",
  "private": true,
  "scripts": {
    "libs": "node scripts/copy-libs.js",
    "icons": "capacitor-assets generate --android --iconBackgroundColor \"#0a1120\" --iconBackgroundColorDark \"#0a1120\" --splashBackgroundColor \"#0a1120\" --splashBackgroundColorDark \"#0a1120\"",
    "android:add": "node -e \"require('fs').existsSync('android')||require('child_process').execSync('npx cap add android',{stdio:'inherit'})\"",
    "prepare:android": "npm run libs && npm run android:add && npm run icons && npx cap sync android",
    "apk": "npm run prepare:android && cd android && gradlew assembleDebug",
    "open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "jspdf": "2.5.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}

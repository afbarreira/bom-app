rules_version = '2';
// Regras de segurança do BOM! (seção 8 do documento)
// - cada usuário lê apenas o próprio perfil, dispositivos e histórico;
// - somente o administrador lê o log de todos e ativa/desativa contas;
// - ninguém consegue se cadastrar como administrador pelo app.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function perfilDe(uid) { return get(/databases/$(database)/documents/usuarios/$(uid)).data; }
    function ehAdmin() { return logado() && perfilDe(request.auth.uid).perfil == 'admin'; }
    function contaAtiva() { return logado() && perfilDe(request.auth.uid).ativo == true; }

    // Coleção usuarios: o código do documento é o uid do Authentication
    match /usuarios/{uid} {
      allow read: if (logado() && request.auth.uid == uid) || ehAdmin();
      allow create: if logado() && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.perfil == 'usuario'
                    && request.resource.data.ativo == true;
      // só o administrador altera, e só o campo "ativo" de outra conta
      allow update: if ehAdmin() && uid != request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo']);
      allow delete: if false;

      // Subcoleção dispositivos
      match /dispositivos/{idDispositivo} {
        allow read: if (logado() && request.auth.uid == uid) || ehAdmin();
        allow write: if logado() && request.auth.uid == uid;
      }
    }

    // Coleção logs_acesso
    match /logs_acesso/{idLog} {
      allow read: if (logado() && resource.data.uid == request.auth.uid) || ehAdmin();
      // login: cria o registro da própria conta, sempre como sessão ativa
      allow create: if contaAtiva()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.situacao == 'ativa'
                    && request.resource.data.horaLogout == null;
      // logout: só preenche a hora de logout e a situação
      allow update: if ((logado() && resource.data.uid == request.auth.uid) || ehAdmin())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['horaLogout', 'situacao']);
      allow delete: if false;
    }
  }
}
